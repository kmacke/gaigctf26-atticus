FROM mcr.microsoft.com/dotnet/sdk:8.0 AS dev
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends ghostscript \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN dotnet restore src/Services/Lamort.DocRender/Lamort.DocRender.csproj

FROM dev AS build
RUN dotnet publish src/Services/Lamort.DocRender/Lamort.DocRender.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ghostscript \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "Lamort.DocRender.dll"]
