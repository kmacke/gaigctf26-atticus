@page "{id:guid}"
@model Lamort.Web.Pages.App.Mortgages.HomePriceModel
@{
    ViewData["Title"] = "Home price range";
}

<main class="shell shell-wide">
    <section class="wizard-hero">
        <div>
            <p class="eyebrow">Mortgage application</p>
            <h1>Home price range</h1>
            <p>Set the price range you want considered so we can align the review with your target purchase.</p>
        </div>
        <div class="wizard-step">Step 5 of 5</div>
    </section>

    <section class="wizard-card">
        <form method="post" class="stack gap-lg" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="split-fields">
                <label>
                    Minimum home price
                    <input asp-for="Input.HomePriceMin" type="number" min="0" step="0.01" />
                </label>
                <label>
                    Maximum home price
                    <input asp-for="Input.HomePriceMax" type="number" min="0" step="0.01" />
                </label>
            </div>

            <div class="wizard-actions">
                <a asp-page="/App/Mortgages/Debts" asp-route-id="@Model.Id" class="button-link secondary">Back</a>
                <button type="submit">Continue</button>
            </div>
        </form>
    </section>
</main>
